# ---------------------------------------------------------------
# ZAROORI - iske bina data download hi nahi hoga
# ---------------------------------------------------------------
# NASA FIRMS map key yahan se milta hai (free):
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=yahan_apni_key_paste_karo

# ---------------------------------------------------------------
# OPTIONAL - satellite photo dekhne wali AI (step4d + step4e)
#
# Iske bina project POORA chalta hai - bas labels sirf rules se
# aayenge aur review queue badi rahegi. Ye key hoti to jahan rules
# chup hain wahan AI photo dekh kar jawab de deti hai.
# ---------------------------------------------------------------
# Gemini (FREE - credit card nahi chahiye). Yahi default hai.
# Key yahan se: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (PAID). Wahi kaam, alag model - src/step4b_vlm.py se.
# Key yahan se: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# OPTIONAL - disaster-level FRP mile to EMAIL alert (step8_live_monitor.py)
#
# Iske bina live monitor poora chalta hai - bas alert sirf console +
# outputs/disaster_alerts.log tak seemit rahega, email nahi jayegi.
# ---------------------------------------------------------------
SMTP_USER=tumhara.email@gmail.com
# Gmail App Password (khud ka Gmail password NAHI):
# Google Account -> Security -> 2-Step Verification (ON karna padega)
# -> App Passwords -> "Mail" ke liye ek 16-character password banao.
SMTP_PASSWORD=
# Jisko alert jana hai - comma se kai log daal sakte ho
ALERT_EMAIL_TO=
